# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:your_postgres_password@127.0.0.1:5432/edu_guidance

# Neo4j Database Connection Configuration
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=edugraph

# LLM & 9router Gateway Configuration (Claude Sonnet / OpenAI compatible)
LLM_API_KEY=your_llm_api_key_here
LLM_API_BASE=http://localhost:20128/v1
LLM_MODEL=ag/claude-sonnet-4-6(high)
LLM_MODEL_NAME=ag/claude-sonnet-4-6(high)
LLM_TIMEOUT=30.0

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000

# Ollama Embedding Settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_TIMEOUT=30.0
EMBEDDER_BATCH_SIZE=50

# Cloudflare R2 private bucket for THPT document ingestion
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=your-private-bucket
R2_REGION=auto
R2_ACCESS_KEY_ID=replace_with_r2_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
PDF_MAX_UPLOAD_BYTES=52428800
PDF_MAX_PAGES=300
PDF_WORKER_POLL_SECONDS=5
PDF_WORKER_MAX_ATTEMPTS=3
SUBJECT_PATHWAY_INTERNAL_API_URL=http://localhost:8080
INTERNAL_SERVICE_TOKEN=replace_with_the_backend_shared_worker_token

# OCRmyPDF and Tesseract are installed in the worker image; local execution needs them on PATH.
# Optional compose worker DB configuration is taken from the backend env file.
