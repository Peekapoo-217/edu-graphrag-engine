# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:your_postgres_password@127.0.0.1:5432/edu_guidance

# Neo4j Database Connection Configuration
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=edugraph

# LLM & 9router Gateway Configuration (Claude Sonnet / OpenAI compatible)
LLM_API_KEY=your_llm_api_key_here
LLM_API_BASE=http://localhost:20128/v1
LLM_MODEL=ag/claude-sonnet-4-6(high)
LLM_MODEL_NAME=ag/claude-sonnet-4-6(high)
LLM_TIMEOUT=30.0

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000

# Ollama Embedding Settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_TIMEOUT=30.0
EMBEDDER_BATCH_SIZE=50

# Same private S3-compatible bucket used by the backend. For local direct worker runs use localhost.
OBJECT_STORAGE_PROVIDER=MINIO
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=thpt-school-documents
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=replace_with_a_local_minio_access_key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace_with_a_strong_local_minio_secret
PDF_MAX_UPLOAD_BYTES=52428800
PDF_MAX_PAGES=300
PDF_WORKER_POLL_SECONDS=5
PDF_WORKER_MAX_ATTEMPTS=3

# OCRmyPDF and Tesseract are installed in the worker image; local execution needs them on PATH.
# Optional compose worker DB configuration is taken from the backend env file.
